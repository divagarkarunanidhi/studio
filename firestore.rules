
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    match /users/{userId} {
      allow get: if isSignedIn();
      allow create, update: if isOwner(userId);
    }

    match /appConfiguration/{configId} {
      allow get: if isSignedIn();
      allow write: if isSignedIn(); // In production, restrict to admin role
    }

    match /sharedFeedback/{feedbackId} {
      allow get, list: if isSignedIn();
      allow create, update, delete: if isSignedIn();
    }

    match /defects/{defectId} {
      allow get, list: if isSignedIn();
      allow create: if isSignedIn() 
        && request.resource.data.reportedBy == request.auth.uid 
        && request.resource.data.id == defectId;
      allow update: if isSignedIn() && (resource.data.reportedBy == request.auth.uid || request.auth.token.email.endsWith('@dhl.com'));
      allow delete: if isSignedIn() && resource.data.reportedBy == request.auth.uid;
    }
  }
}
