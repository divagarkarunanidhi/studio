
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- Global Helper Functions ---

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function hasRole(role) {
      return isSignedIn() && getUserData().role == role;
    }

    function isStaff() {
      return isSignedIn() && getUserData().role in ['admin', 'taas', 'view'];
    }

    // --- Collection Rules ---

    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create: if isOwner(userId);
      allow update: if isOwner(userId);
      allow list: if hasRole('admin');
    }

    match /users/{userId}/defects/{defectId} {
      allow read, write: if isOwner(userId);
    }

    match /appConfiguration/{configId} {
      allow get: if isSignedIn();
      allow write: if hasRole('admin');
    }

    match /sharedFeedback/{feedbackId} {
      allow read: if isSignedIn();
      allow write: if isStaff();
    }

    match /usageEvents/{eventId} {
      allow create: if isSignedIn();
      allow read, list: if hasRole('admin');
    }
  }
}
