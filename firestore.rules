
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- Global Helper Functions ---

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function getUserData() {
      // Safely fetch user data. We use exists() check to prevent evaluation errors if doc is missing.
      let path = /databases/$(database)/documents/users/$(request.auth.uid);
      return exists(path) ? get(path).data : null;
    }

    function hasRole(role) {
      let data = getUserData();
      return isSignedIn() && data != null && data.role == role;
    }

    function isStaff() {
      let data = getUserData();
      return isSignedIn() && data != null && data.role in ['admin', 'taas', 'view'];
    }

    // --- Collection Rules ---

    // Usage Events: Allow any signed-in user to log their activity. 
    // Viewing is restricted to administrators.
    match /usageEvents/{eventId} {
      allow create: if isSignedIn();
      allow read, list: if hasRole('admin');
    }

    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create: if isOwner(userId);
      allow update: if isOwner(userId);
      allow list: if hasRole('admin');
    }

    match /users/{userId}/defects/{defectId} {
      allow read, write: if isOwner(userId);
    }

    match /appConfiguration/{configId} {
      allow get: if isSignedIn();
      allow write: if hasRole('admin');
    }

    match /sharedFeedback/{feedbackId} {
      allow read: if isSignedIn();
      allow write: if isStaff();
    }

    // AutoTrigger Logs: Allow staff to view and log pipeline events.
    match /autoTriggerLogs/{logId} {
      allow read, list, create: if isStaff();
    }
  }
}
