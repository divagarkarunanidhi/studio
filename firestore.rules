
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }
    
    function getUserData() {
      // Helper to fetch current user's profile data
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return isSignedIn() && getUserData().role == 'admin';
    }

    match /users/{userId} {
      // Allow any signed-in user to see profiles (needed for mentions/management)
      allow get: if isSignedIn();
      // Allow admins to list all users
      allow list: if isAdmin();
      // Allow owners or admins to manage profiles
      allow create, update: if isOwner(userId) || isAdmin();
    }

    match /appConfiguration/{configId} {
      // Allow all signed-in users (and authenticated server) to read config
      allow read: if isSignedIn();
      // Restrict writes to admins
      allow write: if isAdmin();
    }

    match /sharedFeedback/{feedbackId} {
      // Shared feedback is readable by all authenticated users for few-shot prompting
      allow read: if isSignedIn();
      allow create, update, delete: if isSignedIn();
    }

    match /defects/{defectId} {
      // Basic CRUD for defects for signed-in users
      allow read: if isSignedIn();
      allow create, update, delete: if isSignedIn();
    }
  }
}
