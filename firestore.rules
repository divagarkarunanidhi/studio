
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isSignedIn() {
      return request.auth != null;
    }

    // Allow server-side reads (unauthenticated) OR owner access.
    function isOwner(userId) {
      return request.auth == null || (isSignedIn() && request.auth.uid == userId);
    }

    function isAdmin() {
      return isSignedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      // Allow users to create their own profile, and allow admins to perform any write.
      allow create: if isOwner(userId);
      allow update, delete: if isAdmin();
    }

    match /sharedFeedback/{feedbackId} {
      // Allow any signed-in user to read, list, and write feedback.
      allow get, list, write: if isSignedIn();
    }

    match /TAASBugSenseAI/{fileId} {
      allow read, create, update, delete: if isSignedIn();
    }

    match /appConfiguration/{configId} {
        // Allow server-side processes (unauthenticated) AND signed-in clients to read.
        allow read: if request.auth == null || isSignedIn(); 
        // Only allow authenticated users (clients) to write the config.
        allow write: if isSignedIn();
    }
  }
}
