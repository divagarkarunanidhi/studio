
{
  "entities": {
    "Defect": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Defect",
      "type": "object",
      "description": "Represents a defect record from the uploaded CSV file.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the Defect entity."
        },
        "domain": {
          "type": "string",
          "description": "The domain to which the defect belongs."
        },
        "reportedBy": {
          "type": "string",
          "description": "The user who reported the defect."
        },
        "createdAt": {
          "type": "string",
          "description": "The date and time when the defect was created.",
          "format": "date-time"
        },
        "status": {
          "type": "string",
          "description": "The current status of the defect (e.g., 'To-Do', 'Ready for Testing')."
        },
        "aiSuggestion": {
          "type": "string",
          "description": "The AI's suggestion for defect reduction."
        },
        "userSuggestion": {
          "type": "string",
          "description": "The user's suggestion for defect reduction."
        },
        "refinedFeedback": {
          "type": "string",
          "description": "AI-refined feedback based on user suggestion, used for future predictions."
        }
      },
      "required": [
        "id",
        "domain",
        "reportedBy",
        "createdAt",
        "status"
      ]
    },
    "UserProfile": {
      "title": "UserProfile",
      "type": "object",
      "properties": {
        "username": { "type": "string" },
        "email": { "type": "string" },
        "role": { "type": "string", "enum": ["admin", "taas", "view", "newuser"] }
      }
    },
    "SharedFeedback": {
      "title": "SharedFeedback",
      "type": "object",
      "properties": {
        "defect": { "$ref": "#/backend/entities/Defect" },
        "prediction": { "type": "object" },
        "savedAt": { "type": "string", "format": "date-time" }
      }
    }
  },
  "auth": {
    "providers": [
      "password",
      "anonymous"
    ]
  },
  "firestore": {
    "structure": [
      {
        "path": "/defects/{defectId}",
        "definition": {
          "entityName": "Defect",
          "schema": {
            "$ref": "#/backend/entities/Defect"
          },
          "description": "Stores individual defect records."
        }
      },
      {
        "path": "/users/{userId}",
        "definition": {
          "entityName": "UserProfile",
          "schema": { "$ref": "#/backend/entities/UserProfile" },
          "description": "User profile and role information."
        }
      },
      {
        "path": "/sharedFeedback/{feedbackId}",
        "definition": {
          "entityName": "SharedFeedback",
          "schema": { "$ref": "#/backend/entities/SharedFeedback" },
          "description": "Feedback used for few-shot learning."
        }
      },
      {
        "path": "/appConfiguration/global",
        "definition": {
          "entityName": "AppConfig",
          "schema": { "type": "object" },
          "description": "Global app settings."
        }
      }
    ]
  }
}
