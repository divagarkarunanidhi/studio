
{
  "entities": {
    "Defect": {
      "title": "Defect",
      "type": "object",
      "description": "Represents a single software defect reported in the system.",
      "properties": {
        "id": { "type": "string" },
        "summary": { "type": "string" },
        "description": { "type": ["string", "null"] },
        "domain": { "type": ["string", "null"] },
        "status": { "type": ["string", "null"] },
        "severity": { "type": ["string", "null"] },
        "priority": { "type": ["string", "null"] },
        "created_at": { "type": "string", "format": "date-time" },
        "updated": { "type": ["string", "null"], "format": "date-time" },
        "reported_by": { "type": ["string", "null"] }
      },
      "required": ["id", "summary", "created_at"]
    },
    "UsageEvent": {
      "title": "UsageEvent",
      "type": "object",
      "description": "Logs of user interactions and system events for auditing and analytics.",
      "properties": {
        "userId": { "type": "string" },
        "username": { "type": ["string", "null"] },
        "eventType": { "enum": ["login", "logout", "menu_click", "session_pulse"] },
        "menuId": { "type": ["string", "null"] },
        "timestamp": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "eventType", "timestamp"]
    },
    "AutoTriggerLog": {
      "title": "AutoTriggerLog",
      "type": "object",
      "description": "History of pipelines triggered via email monitoring.",
      "properties": {
        "emailId": { "type": "string" },
        "sender": { "type": "string" },
        "subject": { "type": "string" },
        "triggeredAt": { "type": "string", "format": "date-time" },
        "gitlabStatus": { "type": "string" },
        "message": { "type": "string" }
      }
    },
    "AppConfiguration": {
      "title": "AppConfiguration",
      "type": "object",
      "description": "Global application settings.",
      "properties": {
        "geminiApiKey": { "type": "string" },
        "mongodbUri": { "type": "string" },
        "mongodbDbName": { "type": "string" },
        "geminiModel": { "type": "string" },
        "geminiRetryModel": { "type": "string" },
        "jiraLink": { "type": "string" },
        "reusabilityLabels": { "type": ["string", "null"] },
        "outlookClientId": { "type": ["string", "null"] },
        "outlookTenantId": { "type": ["string", "null"] },
        "outlookClientSecret": { "type": ["string", "null"] },
        "outlookUserEmail": { "type": ["string", "null"] },
        "outlookSenderFilter": { "type": ["string", "null"] },
        "outlookSubjectFilter": { "type": ["string", "null"] },
        "autoTriggerEnabled": { "type": "boolean" },
        "autoLogoutEnabled": { "type": "boolean" },
        "autoLogoutTime": { "type": "number" }
      }
    }
  },
  "auth": {
    "providers": ["password", "anonymous"]
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/backend/entities/user" },
      "description": "User profiles."
    },
    "/appConfiguration/global": {
      "schema": { "$ref": "#/backend/entities/AppConfiguration" },
      "description": "Global settings singleton."
    },
    "/autoTriggerLogs/{logId}": {
      "schema": { "$ref": "#/backend/entities/AutoTriggerLog" },
      "description": "Historical logs of email-triggered pipelines."
    }
  }
}
