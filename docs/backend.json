
{
  "entities": {
    "Defect": {
      "title": "Defect",
      "type": "object",
      "description": "Represents a single software defect reported in the system.",
      "properties": {
        "id": { "type": "string" },
        "summary": { "type": "string" },
        "description": { "type": ["string", "null"] },
        "domain": { "type": ["string", "null"] },
        "status": { "type": ["string", "null"] },
        "severity": { "type": ["string", "null"] },
        "priority": { "type": ["string", "null"] },
        "created_at": { "type": "string", "format": "date-time" },
        "updated": { "type": ["string", "null"], "format": "date-time" },
        "reported_by": { "type": ["string", "null"] }
      },
      "required": ["id", "summary", "created_at"]
    },
    "UsageEvent": {
      "title": "UsageEvent",
      "type": "object",
      "description": "Logs of user interactions and system events for auditing and analytics.",
      "properties": {
        "userId": { "type": "string" },
        "username": { "type": ["string", "null"] },
        "eventType": { "enum": ["login", "logout", "menu_click", "session_pulse"] },
        "menuId": { "type": ["string", "null"] },
        "timestamp": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "eventType", "timestamp"]
    },
    "AgentTask": {
      "title": "AgentTask",
      "type": "object",
      "description": "Represents a single automated agent pipeline execution.",
      "properties": {
        "id": { "type": "string" },
        "startTime": { "type": "string", "format": "date-time" },
        "endTime": { "type": ["string", "null"], "format": "date-time" },
        "status": { "enum": ["in-progress", "completed", "failed"] },
        "resultsSummary": { "type": ["string", "null"] }
      }
    },
    "AgentActivity": {
      "title": "AgentActivity",
      "type": "object",
      "description": "Individual logs for each agent within a task.",
      "properties": {
        "taskId": { "type": "string" },
        "agentId": { "type": "number" },
        "agentName": { "type": "string" },
        "status": { "enum": ["pending", "running", "success", "error"] },
        "message": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" },
        "data": { "type": ["object", "null"] }
      }
    },
    "AppConfiguration": {
      "title": "AppConfiguration",
      "type": "object",
      "description": "Global application settings.",
      "properties": {
        "geminiApiKey": { "type": "string" },
        "mongodbUri": { "type": "string" },
        "mongodbDbName": { "type": "string" },
        "geminiModel": { "type": "string" },
        "geminiRetryModel": { "type": "string" },
        "jiraLink": { "type": "string" },
        "reusabilityLabels": { "type": ["string", "null"] },
        "seleniumDomainDateRanges": { "type": "object" },
        "confluencePath": { "type": ["string", "null"] },
        "confluencePageId": { "type": ["string", "null"] },
        "confluenceUser": { "type": ["string", "null"] },
        "confluencePassword": { "type": ["string", "null"] },
        "autoLogoutEnabled": { "type": "boolean" },
        "autoLogoutTime": { "type": "number" }
      }
    },
    "SavedPrediction": {
      "title": "SavedPrediction",
      "type": "object",
      "description": "Expert validated feedback for AI training.",
      "properties": {
        "defect": { "$ref": "#/backend/entities/Defect" },
        "prediction": { "type": "object" },
        "savedAt": { "type": "string", "format": "date-time" }
      }
    },
    "user": {
      "title": "user",
      "type": "object",
      "description": "User profile data.",
      "properties": {
        "username": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "role": { "enum": ["admin", "taas", "view", "newuser"] }
      }
    }
  },
  "auth": {
    "providers": ["password", "anonymous"]
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/backend/entities/user" },
      "description": "User profiles."
    },
    "/users/{userId}/defects/{defectId}": {
      "schema": { "$ref": "#/backend/entities/Defect" },
      "description": "User-specific defect uploads."
    },
    "/usageEvents/{eventId}": {
      "schema": { "$ref": "#/backend/entities/UsageEvent" },
      "description": "Application usage logs."
    },
    "/agentTasks/{taskId}": {
      "schema": { "$ref": "#/backend/entities/AgentTask" },
      "description": "History of agent pipeline runs."
    },
    "/agentTasks/{taskId}/activities/{activityId}": {
      "schema": { "$ref": "#/backend/entities/AgentActivity" },
      "description": "Detailed logs for each step in a task."
    },
    "/appConfiguration/global": {
      "schema": { "$ref": "#/backend/entities/AppConfiguration" },
      "description": "Global settings singleton."
    },
    "/sharedFeedback/{feedbackId}": {
      "schema": { "$ref": "#/backend/entities/SavedPrediction" },
      "description": "Expert feedback examples."
    }
  }
}
