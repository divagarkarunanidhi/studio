
{
  "entities": {
    "User": {
      "title": "User",
      "type": "object",
      "description": "Represents a user of the application.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the user (Firebase Auth UID)."
        },
        "username": {
          "type": "string",
          "description": "The user's display name."
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "The user's email address."
        },
        "role": {
          "type": "string",
          "description": "The user's role in the application.",
          "enum": ["admin", "taas", "view", "newuser"]
        }
      },
      "required": ["id", "email", "role"]
    },
    "Defect": {
      "title": "Defect",
      "type": "object",
      "description": "Represents a defect uploaded by a user.",
      "properties": {
        "id": { "type": "string" },
        "summary": { "type": "string" },
        "description": { "type": "string" },
        "domain": { "type": "string" },
        "status": { "type": "string" },
        "reported_by": { "type": "string" },
        "created_at": { "type": "string", "format": "date-time" },
        "updated": { "type": "string", "format": "date-time" },
        "severity": { "type": "string" },
        "priority": { "type": "string" }
      },
      "required": ["id", "summary", "created_at"]
    },
    "DefectFile": {
      "title": "Defect File",
      "type": "object",
      "description": "Represents an uploaded CSV file containing multiple defects.",
      "properties": {
        "uploadedAt": {
          "type": "string",
          "format": "date-time"
        },
        "defects": {
          "type": "array",
          "items": {
            "$ref": "#/backend/entities/Defect"
          }
        },
        "uploaderId": {
          "type": "string"
        }
      },
      "required": ["uploadedAt", "defects", "uploaderId"]
    },
    "SavedPrediction": {
        "title": "Saved Prediction",
        "type": "object",
        "description": "Represents a user-approved defect prediction example for few-shot learning.",
        "properties": {
            "defect": { "$ref": "#/backend/entities/Defect" },
            "prediction": { "$ref": "#/backend/entities/DefectPrediction" },
            "savedAt": { "type": "string", "format": "date-time" }
        },
        "required": ["defect", "prediction", "savedAt"]
    },
    "DefectPrediction": {
      "title": "Defect Prediction",
      "type": "object",
      "description": "Represents the AI's prediction for a defect.",
      "properties": {
        "predictedSeverity": { "type": "string" },
        "predictedPriority": { "type": "string" },
        "predictedRootCause": { "type": "string" },
        "predictedFunctionalArea": { "type": "string" },
        "predictedDefectSuggestions": { "type": "string" }
      },
      "required": ["predictedSeverity", "predictedPriority", "predictedRootCause", "predictedFunctionalArea", "predictedDefectSuggestions"]
    },
    "AppConfiguration": {
      "title": "App Configuration",
      "type": "object",
      "description": "Stores global application configuration settings.",
      "properties": {
        "geminiApiKey": {
          "type": "string"
        },
        "mongodbUri": {
          "type": "string"
        },
        "mongodbDbName": {
          "type": "string"
        },
        "geminiModel": {
          "type": "string"
        },
        "geminiRetryModel": {
          "type": "string"
        },
        "jiraLink": {
          "type": "string"
        },
        "reusabilityLabels": {
          "type": "string",
          "description": "Comma-separated list of labels for test case reusability analysis."
        },
        "seleniumDomainDateRanges": {
          "type": "object",
          "description": "Stores individual date ranges for Selenium report consolidation per domain."
        }
      }
    }
  },
  "auth": {
    "providers": ["emailpassword"],
    "customClaims": {
      "role": {
        "type": "string",
        "enum": ["admin", "taas", "view", "newuser"]
      }
    }
  },
  "firestore": {
    "structure": [
      {
        "path": "/users/{userId}",
        "definition": {
          "entityName": "User",
          "schema": {
            "$ref": "#/backend/entities/User"
          },
          "description": "Stores user-specific data, like roles and preferences.",
          "params": [{ "name": "userId", "description": "The unique identifier for the user, matching their Firebase Auth UID." }]
        }
      },
      {
        "path": "/sharedFeedback/{feedbackId}",
        "definition": {
            "entityName": "SavedPrediction",
            "schema": {
                "$ref": "#/backend/entities/SavedPrediction"
            },
            "description": "Stores user-approved predictions to be used as few-shot examples for all users.",
            "params": [
                { "name": "feedbackId", "description": "The unique ID for the saved feedback." }
            ]
        }
      },
      {
        "path": "/TAASBugSenseAI/{fileId}",
        "definition": {
          "entityName": "DefectFile",
          "schema": {
            "$ref": "#/backend/entities/DefectFile"
          },
          "description": "Stores uploaded defect files.",
          "params": [
            { "name": "fileId", "description": "The unique ID for the uploaded file." }
          ]
        }
      },
      {
        "path": "/appConfiguration/{configId}",
        "definition": {
            "entityName": "AppConfiguration",
            "schema": {
                "$ref": "#/backend/entities/AppConfiguration"
            },
            "description": "Stores a single document for global app configuration.",
            "params": [
                { "name": "configId", "description": "The static ID for the configuration document, typically 'global'." }
            ]
        }
      }
    ]
  }
}
